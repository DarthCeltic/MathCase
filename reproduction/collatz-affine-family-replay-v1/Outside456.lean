theorem batches_ok : batches.all (fun block => block.all accepted) = true := by
  simp only [batches, List.all_cons, List.all_nil]
  apply Bool.and_eq_true_iff.mpr
  refine ⟨rows000_ok, ?_⟩
  apply Bool.and_eq_true_iff.mpr
  refine ⟨rows001_ok, ?_⟩
  apply Bool.and_eq_true_iff.mpr
  refine ⟨rows002_ok, ?_⟩
  apply Bool.and_eq_true_iff.mpr
  refine ⟨rows003_ok, ?_⟩
  apply Bool.and_eq_true_iff.mpr
  refine ⟨rows004_ok, ?_⟩
  apply Bool.and_eq_true_iff.mpr
  refine ⟨rows005_ok, ?_⟩
  apply Bool.and_eq_true_iff.mpr
  refine ⟨rows006_ok, ?_⟩
  apply Bool.and_eq_true_iff.mpr
  refine ⟨rows007_ok, ?_⟩
  apply Bool.and_eq_true_iff.mpr
  refine ⟨rows008_ok, ?_⟩
  apply Bool.and_eq_true_iff.mpr
  refine ⟨rows009_ok, ?_⟩
  apply Bool.and_eq_true_iff.mpr
  refine ⟨rows010_ok, ?_⟩
  apply Bool.and_eq_true_iff.mpr
  refine ⟨rows011_ok, ?_⟩
  apply Bool.and_eq_true_iff.mpr
  refine ⟨rows012_ok, ?_⟩
  apply Bool.and_eq_true_iff.mpr
  refine ⟨rows013_ok, ?_⟩
  apply Bool.and_eq_true_iff.mpr
  refine ⟨rows014_ok, ?_⟩
  rfl

def outsideRows : List (Nat × Nat) := batches.flatten

/-- Quantified conclusion for the prespecified outside sample, using only the listed pairs and a single symbolic proof. -/
theorem all_rows (r q : Nat) (listed : (r,q) ∈ outsideRows) (k : Nat) :
    m20Iterate (1048576*k+r) 32 = 531441*k+q ∧ 531441*k+q < 1048576*k+r := by
  obtain ⟨block, hBlock, hRow⟩ := List.mem_flatten.mp listed
  have hb := List.all_eq_true.mp batches_ok block hBlock
  have hr : accepted (r,q) = true := List.all_eq_true.mp hb (r,q) hRow
  have cert : familyEndpoint 32 1048576 r = some (531441,q) ∧ q < r :=
    of_decide_eq_true hr
  exact m20Family_descent cert.1 (by decide) cert.2 k

#print axioms all_rows
end MathCase.Outside456
